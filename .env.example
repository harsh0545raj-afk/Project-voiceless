# VOICELESS Environment Variables Template
# Copy this file to .env.local for local overrides.
# NOTE: Do NOT commit any real private secrets or live production API keys.

# Environment Mode
VITE_APP_ENV=development
VITE_SITE_URL=https://voiceless.welfare

# Donation Readiness Feature Flag
# KEEP FALSE until statutory legal registration (80G/12A), audited bank accounts,
# and verified payment gateway agreements are completed.
VITE_ENABLE_LIVE_DONATIONS=false

# Payment Gateway Configuration (For Future Activation in Phase 2)
# Supported options: Razorpay, Stripe, or Cashfree
VITE_PAYMENT_GATEWAY_PROVIDER=razorpay
VITE_PAYMENT_KEY_ID=rzp_test_placeholder_key_id

# Optional Form Backend Endpoint
# E.g., Formspree, Resend, or Custom Node / Cloudflare Worker endpoint
VITE_CONTACT_FORM_ENDPOINT=

# Analytics & Observability (Disabled by default to protect user privacy)
VITE_ENABLE_ANALYTICS=false
